    <!-- http://purl.obolibrary.org/obo/MS_1000340 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000340">
        <obo:IAO_0000115>OBSOLETE An ion that reacts to form particular product ions. The reaction can be unimolecular dissociation, ion/molecule reaction, isomerization, or change in charge state. The term parent ion is deprecated.</obo:IAO_0000115>
