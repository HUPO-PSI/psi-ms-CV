    <!-- http://purl.obolibrary.org/obo/MS_1001322 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1001322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002095"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_value_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Only used in Peptide Summary and Select Summary reports. If true, a peptide match must be &apos;bold red&apos; to be included in the report; bold red means the peptide is a top ranking match in a query and appears for the first time (in linear order) in the list of protein hits.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1001322</oboInOwl:id>
        <rdfs:label>Mascot:RequireBoldRed</rdfs:label>
    </owl:Class>
    <owl:Axiom>
