        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1003786"/>
        <obo:IAO_0000115>Capillary electrophoresis (CE) is an electrophoretic separation technique performed in narrow-bore capillaries, in which analytes migrate through an electrolyte solution under the influence of an electric field and separate according to their electrophoretic mobility.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>CE</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>capilliary zone electrophoresis</oboInOwl:hasExactSynonym>
