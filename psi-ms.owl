    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000778 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000778">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000543"/>
        <obo:IAO_0000115>A process that infers the charge state of an MSn spectrum&apos;s precursor(s) by the application of some algorithm.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000778</oboInOwl:id>
        <rdfs:label>charge state calculation</rdfs:label>
    </owl:Class>
