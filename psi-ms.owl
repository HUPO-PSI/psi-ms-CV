    <!-- http://purl.obolibrary.org/obo/MS_1000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000230">
        <obo:IAO_0000115>OBSOLETE Odd-electron ions may dissociate to form either odd or even-electron ions, whereas even-electron ions generally form even-electron fragment ions.</obo:IAO_0000115>
