        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE A collision between an ion and neutral species with translational energy approximately 1000 eV or lower.</owl:annotatedTarget>
