    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000418">
        <obo:IAO_0000115>OBSOLETE The reaction of an ion with a neutral species in which the translational energy of the collision is converted into internal energy of the ion.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
