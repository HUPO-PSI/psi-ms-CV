    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000306 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000306">
        <obo:IAO_0000115>OBSOLETE A mass spectrometer in which m/z separation using one or more electric fields that vary with time.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
