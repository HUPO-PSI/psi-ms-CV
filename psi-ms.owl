        <owl:annotatedTarget>The area under the total ion chromatogram.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_4000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_4000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_4000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_metric_category"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MS_4000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_metric_category"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MS_4000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The area under the total ion chromatogram of the retention time quantiles. Number of quantiles are given by the n-tuple.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:4000156</oboInOwl:id>
        <rdfs:comment>The metric informs about the dynamic range of the acquisition along the chromatographic separation. Differences between samples of an experiment may indicate differences in chromatographic performance, differences in the dynamic range and/or in the sample content.</rdfs:comment>
        <rdfs:label>area under TIC RT quantiles</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_4000156"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The area under the total ion chromatogram of the retention time quantiles. Number of quantiles are given by the n-tuple.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_4000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_4000157">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_4000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_metric_category"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MS_4000008"/>
