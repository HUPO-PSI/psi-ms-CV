    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000291"/>
        <obo:IAO_0000115>A linear ion trap mass analyzer where ions are ejected along the radius of the analyzer.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000083</oboInOwl:id>
        <rdfs:label>radial ejection linear ion trap</rdfs:label>
