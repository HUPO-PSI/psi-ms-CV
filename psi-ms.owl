    <!-- http://purl.obolibrary.org/obo/MS_1000413 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000413">
        <obo:IAO_0000115>OBSOLETE Fragmentation of an odd electron ion in which the cleaved bond is adjacent to the apparent charge site. Synonymous with charge mediated fragmentation.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
