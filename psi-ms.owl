    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000008"/>
