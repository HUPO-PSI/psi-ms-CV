                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MS_4000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The QC metric type describes what type the corresponding metric is. Possible types are single value, n-tuple, table, or matrix.</obo:IAO_0000115>
