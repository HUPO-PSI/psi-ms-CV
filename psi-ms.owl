    <!-- http://purl.obolibrary.org/obo/MS_1000272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000008"/>
        <obo:IAO_0000115>With this technique, m/z selected ions form neutrals by charge transfer to a collision gas or by dissociation. The neutrals are separated from the remaining ions and ionized in collisions with a second gas. This method is used to investigate reaction intermediates and other unstable species.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>NRMS</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000272</oboInOwl:id>
        <rdfs:label>neutralization reionization mass spectrometry</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>With this technique, m/z selected ions form neutrals by charge transfer to a collision gas or by dissociation. The neutrals are separated from the remaining ions and ionized in collisions with a second gas. This method is used to investigate reaction intermediates and other unstable species.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000008"/>
        <obo:IAO_0000115>The ionization of an atom or molecule by a photon, written M + h? ? M^+ + e. The term photon impact is not recommended.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PI</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000273</oboInOwl:id>
        <rdfs:label>photoionization</rdfs:label>
    </owl:Class>
