    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000430 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000430">
        <obo:IAO_0000115>OBSOLETE In this reaction an association reaction is accompanied by the subsequent or simultaneous liberation of a different neutral species as a product.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000430</oboInOwl:id>
