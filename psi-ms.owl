    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000108">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000346"/>
        <obo:IAO_0000115>A surface that is held at high potential so that ions striking the surface produce electrons that are subsequently detected.</obo:IAO_0000115>
