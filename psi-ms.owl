        <owl:annotatedTarget>A process of reducing spikes of intensity in order to reduce noise while preserving real peak signal. Many algorithms can be applied for this process.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000593 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000543"/>
        <obo:IAO_0000115>A process of removal of varying intensities generated due to variable energy absorption before further processing can take place. Baseline reduction facilitates meaningful comparison between intensities of m/z values.</obo:IAO_0000115>
