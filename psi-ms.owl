    <!-- http://purl.obolibrary.org/obo/MS_1000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000240"/>
        <obo:IAO_0000115>Matrix-assisted laser desorption ionization in which the sample target is at atmospheric pressure and the ions formed by the pulsed laser are sampled through a small aperture into the mass spectrometer.</obo:IAO_0000115>
