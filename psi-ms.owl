    <!-- http://purl.obolibrary.org/obo/MS_1003901 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003901">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000543"/>
        <obo:IAO_0000115>Apply an algorithm to remove excess zero intensity value data points from a spectrum. Data may be retained for interperatbility such as retaining only zeros that flank non-zero intensity value data points from a profile spectrum..</obo:IAO_0000115>
