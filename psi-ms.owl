    <!-- http://purl.obolibrary.org/obo/MS_1003904 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003904">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1003903"/>
        <obo:IAO_0000115>An analytical approach in which comprehensive detection of all measurable analytes is attempted without prior specification of target compounds.</obo:IAO_0000115>
