    <!-- http://purl.obolibrary.org/obo/MS_1000342 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000342">
        <obo:IAO_0000115>OBSOLETE An ion formed as the product of a reaction involving a particular precursor ion. The reaction can be unimolecular dissociation to form fragment ions, an ion/molecule reaction, or simply involve a change in the number of charges. The term fragment ion is deprecated. The term daughter ion is deprecated.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>daughter ion</oboInOwl:hasRelatedSynonym>
