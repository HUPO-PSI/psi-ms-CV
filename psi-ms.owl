    <!-- http://purl.obolibrary.org/obo/MS_1000429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000429">
        <obo:IAO_0000115>OBSOLETE A process wherein a charged species interacts with a neutral reactant to produce either chemically different species or changes in the internal energy of one or both of the reactants.</obo:IAO_0000115>
