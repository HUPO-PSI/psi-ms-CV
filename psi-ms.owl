                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_value_concept"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/STATO_0000291"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
