    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1003303 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002694"/>
        <rdfs:subClassOf>
            <owl:Restriction>
