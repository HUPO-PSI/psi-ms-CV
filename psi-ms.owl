        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An on-line coupled system to effect separation of compounds prior to detection with a spectrometric or other detection technology.</owl:annotatedTarget>
