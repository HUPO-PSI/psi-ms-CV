        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000424"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE Exchange of hydrogen atoms with deuterium atoms in a molecule or pre-formed ion in solution prior to introduction into a mass spectrometer, or by reaction of an ion with a deuterated collision gas inside a mass spectrometer.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000425 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000425">
        <obo:IAO_0000115>OBSOLETE A plot of the relative abundance of a beam or other collection of ions as a function their loss of translational energy in reactions with neutral species.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000425</oboInOwl:id>
        <rdfs:comment>This former purgatory term was made obsolete.</rdfs:comment>
        <rdfs:label>ion energy loss spectrum</rdfs:label>
