    <!-- http://purl.obolibrary.org/obo/MS_1000599 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000599">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000044"/>
        <obo:IAO_0000115>A process that involves precursor ion activation at high Q, a time delay to allow the precursor to fragment, then a rapid pulse to low Q where all fragment ions are trapped. The product ions can then be scanned out of the ion trap and detected.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PQD</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000599</oboInOwl:id>
        <rdfs:label>pulsed q dissociation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000599"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process that involves precursor ion activation at high Q, a time delay to allow the precursor to fragment, then a rapid pulse to low Q where all fragment ions are trapped. The product ions can then be scanned out of the ion trap and detected.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000600 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000600">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1001456"/>
