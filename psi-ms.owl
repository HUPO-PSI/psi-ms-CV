        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000391"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE The reaction of a molecule to form both a positive ion and negative ion fragment among the products.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000392 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000392">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000482"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_value_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ratio of the number of ions formed to the number of electrons, molecules or photons used.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000392</oboInOwl:id>
        <rdfs:label>ionization efficiency</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000392"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The ratio of the number of ions formed to the number of electrons, molecules or photons used.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000393 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000393">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000247"/>
        <obo:IAO_0000115>The formation of gas-phase ions by the interaction of a pulsed laser with a solid or liquid material.</obo:IAO_0000115>
