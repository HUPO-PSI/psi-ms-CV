    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000417">
        <obo:IAO_0000115>OBSOLETE The reaction of an ion with a neutral species in which some or all of the charge of the reactant ion is transferred to the neutral species.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000417</oboInOwl:id>
