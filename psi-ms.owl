    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000269">
        <obo:IAO_0000115>OBSOLETE The acquisition, study and spectra of the electrically charged products or precursors of a m/z selected ion or ions.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>MS/MS</oboInOwl:hasExactSynonym>
