    <!-- http://purl.obolibrary.org/obo/MS_1000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000237">
        <obo:IAO_0000115>OBSOLETE A non-SI unit of mass (u) defined as one twelfth of ^12 C in its ground state and equal to 1.660 538 86(28) x 10^-27 kg.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>u</oboInOwl:hasExactSynonym>
