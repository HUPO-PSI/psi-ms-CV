    <!-- http://purl.obolibrary.org/obo/MS_4000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_4000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_4000004"/>
