        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A process that infers the charge state of an MSn spectrum&apos;s precursor(s) by the application of some algorithm.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000779 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000779">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000778"/>
        <obo:IAO_0000115>Infers charge state as single or ambiguously multiple by determining the fraction of intensity below the precursor m/z.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000779</oboInOwl:id>
        <rdfs:label>below precursor intensity dominance charge state calculation</rdfs:label>
    </owl:Class>
