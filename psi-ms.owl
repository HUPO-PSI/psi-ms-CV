            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Number of data points in a spectrum. For a peak-picked spectrum, this will correspond to the number of peaks. For a non-peak-picked spectrum, this corresponds to the number of values in the data array, which are not all peaks.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003060</oboInOwl:id>
        <rdfs:label>number of data points</rdfs:label>
