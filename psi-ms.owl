    <!-- http://purl.obolibrary.org/obo/MS_1000433 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000433">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1000044"/>
        <obo:IAO_0000115>A collision-induced dissociation process wherein the precursor ion has the translational energy lower than approximately 1000 eV. This process typically requires multiple collisions and the collisional excitation is cumulative.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000433</oboInOwl:id>
