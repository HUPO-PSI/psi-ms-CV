    <!-- http://purl.obolibrary.org/obo/MS_1003712 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003712">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002272"/>
        <obo:IAO_0000115>Fast gas chromatography (fast GC, FGC) employs short, narrow-bore capillary columns, high carrier gas velocity, and rapid temperature programming to achieve high-efficiency separations in a fraction of standard GC run times.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003712</oboInOwl:id>
        <rdfs:label>fast gas chromatography</rdfs:label>
