    <!-- http://purl.obolibrary.org/obo/MS_1000414 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000414">
        <obo:IAO_0000115>OBSOLETE Reaction of an ion with a neutral species in which the charge on the product ion is reversed in sign with respect to the reactant ion.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
