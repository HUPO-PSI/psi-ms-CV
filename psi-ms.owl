                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>OBSOLETE The proton affinity of a species M is defined as the negative of the enthalpy change for the reaction M + H+ -&gt;[M+H]+, where all species are in their ground rotational, vibrational and electronic states.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>PA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000233</oboInOwl:id>
        <rdfs:comment>This child of the former purgatory term ion attribute was made obsolete.</rdfs:comment>
        <rdfs:label>proton affinity</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000233"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE The proton affinity of a species M is defined as the negative of the enthalpy change for the reaction M + H+ -&gt;[M+H]+, where all species are in their ground rotational, vibrational and electronic states.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000233"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>PA</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000234">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_value_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>OBSOLETE In a mass spectrum, the observed mass divided by the difference between two masses that can be separated. The method by which delta m was obtained and the mass at which the measurement was made should be reported.</obo:IAO_0000115>
