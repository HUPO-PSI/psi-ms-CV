                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_metric_category"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MS_4000021"/>
            </owl:Restriction>
        </rdfs:subClassOf>
