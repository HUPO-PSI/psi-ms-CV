        <owl:annotatedTarget>Normal-phase (NP) chromatography is a technique used to separate compounds based primarily on their polarity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1003584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002271"/>
        <obo:IAO_0000115>Hydrophilic Interaction Liquid Chromatography (HILIC) is a chromatographic technique for the separation of polar and hydrophilic compounds. HILIC employs a polar stationary phase that absorbs water from the mobile phase to form a hydrophilic layer that retains polar analytes.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003584</oboInOwl:id>
        <rdfs:label>hydrophilic interaction liquid chromatography</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1003584"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Hydrophilic Interaction Liquid Chromatography (HILIC) is a chromatographic technique for the separation of polar and hydrophilic compounds. HILIC employs a polar stationary phase that absorbs water from the mobile phase to form a hydrophilic layer that retains polar analytes.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1003585 -->

