        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>OBSOLETE A smoothing of the distribution of q-values calculated for PSMs from individual search engines, such that ordering of result quality is maintained and all FDRScore values are guaranteed to have a value &gt; 0.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:19253293</oboInOwl:hasDbXref>
    </owl:Axiom>
    


