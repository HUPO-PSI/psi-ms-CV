        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Chiral separation in liquid chromatography is the process of resolving enantiomers.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1003586 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003586">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002271"/>
        <obo:IAO_0000115>Mixed-mode separation in liquid chromatography uses stationary phases that combine multiple types of interactions to retain and separate compounds.</obo:IAO_0000115>
