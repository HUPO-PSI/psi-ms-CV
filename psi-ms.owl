        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MS_1000273"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The ionization of an atom or molecule by a photon, written M + h? ? M^+ + e. The term photon impact is not recommended.</owl:annotatedTarget>
