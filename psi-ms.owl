        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1000305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000305">
        <obo:IAO_0000115>OBSOLETE The circular motion of a charged particle moving at velocity v in a magnetic field B that results from the force qvB.</obo:IAO_0000115>
