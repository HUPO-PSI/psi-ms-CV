    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003590">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1003589"/>
        <obo:IAO_0000115>A system for High-Performance Liquid Chromatography (HPLC), a widely used analytical chemistry technique for separating, identifying, and quantifying individual components in a liquid mixture.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003590</oboInOwl:id>
        <rdfs:label>high-performance liquid chromatography system</rdfs:label>
    </owl:Class>
