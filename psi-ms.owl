    <!-- http://purl.obolibrary.org/obo/MS_1000415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1000415">
        <obo:IAO_0000115>OBSOLETE The reaction of an ion with a neutral species with a resulting change in the magnitude or sign of the charge on the reactant ion.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000415</oboInOwl:id>
