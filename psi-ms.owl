            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>OBSOLETE The electron affinity of M is the minimum energy required for the process M- ? M + e where M- and M are in their ground rotational, vibrational and electronic states and the electron has zero kinetic energy.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>EA</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1000213</oboInOwl:id>
        <rdfs:comment>This child of the former purgatory term ion attribute was made obsolete.</rdfs:comment>
        <rdfs:label>electron affinity</rdfs:label>
