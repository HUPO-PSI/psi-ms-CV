        <owl:annotatedTarget>Reversed-phase (RP) chromatography is a technique used to separate compounds based primarily on their hydrophobicity.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PSI:MS</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MS_1003583 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MS_1003583">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002271"/>
        <obo:IAO_0000115>Normal-phase (NP) chromatography is a technique used to separate compounds based primarily on their polarity.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003583</oboInOwl:id>
