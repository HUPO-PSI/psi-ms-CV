            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_units"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UO_0000218"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ms#has_value_type"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The electrical potential used to impart kinetic energy to ions in a mass spectrometer.</obo:IAO_0000115>
