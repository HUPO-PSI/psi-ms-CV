        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MS_1002271"/>
        <obo:IAO_0000115>Electrochromatography is a liquid chromatography technique in which the mobile phase is driven through a stationary phase by electroosmotic flow generated by an applied electric field, combining electrophoretic migration with chromatographic retention.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>MS</oboInOwl:hasOBONamespace>
        <oboInOwl:id>MS:1003788</oboInOwl:id>
